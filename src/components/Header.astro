---
import { PAGES, SITE } from '../data/site';
import { asset, href } from '../lib/urls';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Slug of the page being rendered, so the matching tab is marked current. */
  current: string;
  /** Note pages render a sidebar, so they also get the drawer button. */
  hasSidebar?: boolean;
}

const { current, hasSidebar = false } = Astro.props;
---

<header class:list={['site-header', { 'has-sidebar': hasSidebar }]}>
  {
    hasSidebar && (
      <button
        type="button"
        class="icon-btn sidebar-open"
        id="sidebar-open"
        aria-label="Open navigation"
        aria-controls="sidebar"
        aria-expanded="false"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M1.5 3h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1 0-1Zm0 4.5h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1 0-1ZM1.5 12h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1 0-1Z" />
        </svg>
      </button>
    )
  }

  <!-- The menu button always sits to the left of the wordmark, on every page,
       so the header's leading control never moves between pages. -->
  <button type="button" class="icon-btn nav-toggle" id="nav-toggle" aria-label="Menu" aria-controls="top-nav" aria-expanded="false">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
      <path d="M1.5 3h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1 0-1Zm0 4.5h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1 0-1ZM1.5 12h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1 0-1Z" />
    </svg>
  </button>

  <a class="brand" href={href('')}>
    <img src={asset('images/site-mark-no-bg.png')} alt="" width="30" height="30" />
    <span><span class="brand-full">AI-103 </span>Study Notes</span>
  </a>

  <nav class="top-nav" id="top-nav" aria-label="Main">
    {
      PAGES.map((p) => (
        <a href={href(p.slug)} aria-current={p.slug === current ? 'page' : undefined}>
          {p.navLabel}
        </a>
      ))
    }
  </nav>

  <div class="header-tools">
    <a class="ghub-link" href={SITE.repo} target="_blank" rel="noopener" title="Star this repository on GitHub">
      ⭐ <span>on</span>
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <!-- The star emoji carries the meaning visually; screen readers get the
           full phrase here instead. -->
      <span class="visually-hidden">Star this repository on GitHub</span>
    </a>
    <ThemeToggle />
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('top-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Close the dropdown when focus or a click lands outside it.
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!nav.classList.contains('open')) return;
      if (nav.contains(target) || toggle.contains(target)) return;
      nav.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }
</script>
