    CTX --> P["Prompt:<br/>instructions + context + question"]
    P --> M["Model"] --> ANS["Grounded answer<br/>with citations"]
  end
`;

const agentLoop = `
sequenceDiagram
  autonumber
  participant U as User
  participant R as Agent runtime
  participant M as Model
  participant T as Tool

  U->>R: responses.create(conversation, input)
  R->>R: Guardrail — user input
  R->>M: instructions + conversation items + tool schemas
  M-->>R: tool_call(name, arguments)
  R->>R: Guardrail — tool call (agents, preview)
  R->>T: Invoke tool
  T-->>R: Tool result
  R->>R: Guardrail — tool response (agents, preview)
  R->>M: Conversation + tool result
  M-->>R: Final message
  R->>R: Guardrail — output
  R-->>U: Response + citations, persisted as items
`;

const multiAgent = `
flowchart TB
  subgraph SEQ["Sequential"]
    A1["Extract"] --> A2["Validate"] --> A3["Summarise"]
  end
  subgraph CON["Concurrent"]
    C0["Fan out"] --> C1["Legal"] & C2["Finance"] & C3["Technical"]
    C1 & C2 & C3 --> C4["Aggregate"]
  end
  subgraph HAND["Handoff"]
    H0["Triage"] -->|"transfers ownership"| H1["Refunds"]
    H0 -->|"transfers ownership"| H2["Orders"]
  end
  subgraph TOOLS["Agent-as-tool"]
    T0["Primary agent<br/>keeps ownership"] --> T1["Specialist<br/>returns a result"]
