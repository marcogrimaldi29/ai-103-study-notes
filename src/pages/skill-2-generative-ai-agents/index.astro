const ragAgent = `from azure.identity import DefaultAzureCredential
from azure.ai.projects import AIProjectClient
from azure.ai.projects.models import PromptAgentDefinition

project = AIProjectClient(
    endpoint="https://my-foundry.services.ai.azure.com/api/projects/my-project",
    credential=DefaultAzureCredential(),
)

# A prompt agent is pure configuration: model + instructions + tools.
agent = project.agents.create_version(
    agent_name="policy-assistant",
    definition=PromptAgentDefinition(
        model="gpt-5-mini",
        instructions=(
            "You are an HR policy assistant for Contoso. "
            "Answer ONLY from the retrieved policy documents and always cite the "
            "document name. If the documents do not cover the question, say so "
            "and suggest contacting HR — never guess."
        ),
        tools=[
            {
                "type": "file_search",
                "vector_store_ids": ["vs_hr_policies"],
            }
        ],
    ),
)
print(agent.id, agent.name, agent.version)`;

const functionTool = `# A function tool is a JSON Schema the model can choose to call.
# The schema IS the prompt for the tool: names and descriptions decide
# whether the model picks it correctly.
create_ticket = {
    "type": "function",
    "name": "create_support_ticket",
    "description": (
        "Create a support ticket in ServiceNow. Use only after the user has "
        "confirmed the summary. Do not use for questions that documentation answers."
    ),
    "parameters": {
        "type": "object",
        "properties": {
            "title": {"type": "string", "description": "Short one-line summary"},
            "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"],
                "description": "Business impact, not user frustration",
            },
            "description": {"type": "string"},
        },
        "required": ["title", "severity", "description"],
        "additionalProperties": False,
    },
}

response = openai.responses.create(
    model="gpt-5-mini",
    input="Raise a high severity ticket: the checkout page is returning 500s.",
    tools=[create_ticket],
)

for item in response.output:
    if item.type == "function_call":
        args = json.loads(item.arguments)
        result = servicenow.create(**args)
        # Feed the result back in, referencing the call id.
        response = openai.responses.create(
            model="gpt-5-mini",
            previous_response_id=response.id,
            input=[{
                "type": "function_call_output",
                "call_id": item.call_id,
                "output": json.dumps(result),
            }],
        )
print(response.output_text)`;

const structuredOutput = `from pydantic import BaseModel

class Ticket(BaseModel):
    title: str
    severity: str
    affected_service: str
    customer_impacting: bool

# Structured outputs constrain generation to the schema, so downstream code
# never has to parse free text or defend against a stray markdown fence.
response = openai.responses.parse(
    model="gpt-5-mini",
    input=email_body,
    text_format=Ticket,
)
ticket = response.output_parsed
print(ticket.severity, ticket.customer_impacting)`;

const evalCode = `from azure.ai.evaluation import (
    GroundednessEvaluator, RelevanceEvaluator, evaluate,
)

model_config = {
    "azure_endpoint": AZURE_ENDPOINT,
    "azure_deployment": "gpt-5-mini",   # the judge model
}

results = evaluate(
    data="golden_questions.jsonl",       # query, context, response, ground_truth
    evaluators={
        "groundedness": GroundednessEvaluator(model_config),  # catches fabrications
        "relevance": RelevanceEvaluator(model_config),
    },
    azure_ai_project=PROJECT_ENDPOINT,   # publishes results to the portal
)

# Fail the CI job on regression rather than eyeballing a dashboard.
assert results["metrics"]["groundedness.groundedness"] >= 4.0`;
